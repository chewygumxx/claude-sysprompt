{
    "$schema": "https://www.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "enabledPlugins": {
        "claude-md-management@claude-plugins-official": true,
        "github@claude-plugins-official": true,
        "code-simplifier@claude-plugins-official": true,
        "code-review@claude-plugins-official": true,
        "superpowers@claude-plugins-official": true,
        "claude-code-setup@claude-plugins-official": true,
        "remember@claude-plugins-official": true,
        "agent-sdk-dev@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -z \"$f\" ] && exit 0; [ -f \"$f\" ] || exit 0; grep -Iqn '—' \"$f\" && { echo \"Em dash (U+2014) found in $f. CLAUDE.md prohibits em dashes in this repo; remove it.\" >&2; exit 2; }; exit 0; }",
                        "statusMessage": "Checking for em dashes"
                    }
                ]
            }
        ]
    }
}
