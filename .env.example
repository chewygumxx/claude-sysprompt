# Copy to .env and fill in one of the two auth methods below. .env is
# gitignored; never commit real credentials.

# Pay-per-token API auth.
# ANTHROPIC_API_KEY=

# Claude Pro/Max subscription auth. Mint with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
