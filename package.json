{
  "name": "claude-sysprompt",
  "version": "1.0.0",
  "description": "Experimentation with configuring a custom system prompt via Claude Code Agent SDK",
  "private": true,
  "homepage": "https://github.com/chewygumxx/claude-sysprompt#readme",
  "bugs": {
    "url": "https://github.com/chewygumxx/claude-sysprompt/issues"
  },
  "repository": "github:chewygumxx/nvim-config",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.7",
    "remark-frontmatter": "^5.0.0",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "commit": "cz",
    "prepare": "test -d node_modules/husky && husky || true",
    "typecheck": "tsc"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "patchedDependencies": {
    "@commitlint/cz-commitlint@21.2.2": "patches/@commitlint/cz-commitlint@21.2.2.patch"
  },
  "remarkConfig": {
    "settings": {
      "bullet": "-"
    },
    "plugins": [
      "remark-frontmatter",
      "remark-preset-lint-recommended",
      "remark-preset-lint-consistent"
    ]
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  }
}
